    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "expo": "~58.0.23",
    "expo-camera": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.0",
    "resend": "^6.37.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
